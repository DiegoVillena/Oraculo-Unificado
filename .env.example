# === Template de variables de entorno - Oráculo Unificado ===
# Copia este archivo a .env y rellena los valores reales.
# El .env real está en .gitignore y NUNCA se commitea.

# URL pública del Cloudflare Worker (proxy a Gemini). La API key vive en los
# secrets del Worker (wrangler secret put GEMINI_KEY), no en este archivo.
VITE_WORKER_URL=https://oraculo-worker.diegovillens.workers.dev
VITE_GEMINI_MODEL=gemini-3.1-flash-lite
VITE_IA_TIMEOUT_MS=45000