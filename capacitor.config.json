{
  "appId": "com.oraculounificado.app",
  "appName": "Oráculo Unificado",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#050214",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    }
  },
  "icons": {
    "android": {
      "source": "icon.png",
      "adaptive": {
        "foreground": "icon.png",
        "background": "#050214"
      }
    }
  }
}