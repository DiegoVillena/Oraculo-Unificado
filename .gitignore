# === Secretos y entorno ===
# Evita subir credenciales accidentalmente.
.env
.env.*
!.env.example
*.local
secrets.properties
local.defaults.properties

# === Keystore de firma release ===
# La clave de firma es secreta: nunca la subas al repositorio.
*.keystore
*.jks
keystore.properties

# === Node ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Build artifacts ===
*.apk
*.aab
*.ap_
*.dex
build/
out/
dist/
.gradle/

# === IDE ===
.idea/
*.iml
.vscode/
*.swp

# === OS ===
.DS_Store
Thumbs.db

# === Logs ===
*.log

# === Python (scripts) ===
__pycache__/
*.pyc
# === Datos fuente grandes (descargables, no necesarios para build) ===
scripts/geonames/cities5000.txt
scripts/geonames/ES.txt
scripts/geonames/*.txt

# === Imágenes de debug ===
medallon_debug.png
medallon_puro.png
medallon_con_fondo.png
medallon_interior.png
centro_medallon.png

# === Duplicados www/ (se regeneran con cap sync desde js/) ===
# www/ es la salida de js/, se sincroniza con cap sync.
# Lo subimos para que el build funcione sin cap sync, pero
# evitamos duplicar SQLite grandes (se copia de js/).
www/js/data/ciudades.sqlite

# === Archivos temporales ===
*.tmp
.bash_history
